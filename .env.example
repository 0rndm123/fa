# Replace with YOUR actual identifying email before contacting SEC.
SEC_USER_AGENT="FA Agent Your Name real.email@example.org"
# Optional, only for LangChain LLM synthesis in live mode:
OPENAI_API_KEY=
FA_LLM_MODEL=gpt-4.1-mini

# Optional SysTrd API integration (set as a process/Windows User env variable).
# Local SysTrd Control Center API default; not the Vite frontend (5173).
FA_SYSTRD_API_URL=http://127.0.0.1:8010
# Optional: disambiguates competing calculator versions.
FA_SYSTRD_CALCULATOR_VERSION=rm-pilot-experimental-v1
# Only for secure_remote SysTrd: a short-lived authorised Supabase JWT.
# FA_SYSTRD_ACCESS_TOKEN=
